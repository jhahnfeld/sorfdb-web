{
  "name": "sorfdb-web",
  "version": "0.3.24",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest --environment jsdom --root src/",
    "test:unit:ci": "vitest --environment jsdom --root src/ run",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-pattern .gitignore",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "file-saver": "^2.0.5",
    "json5": "^2.2.3",
    "pako": "^2.1.0",
    "plotly.js-dist-min": "^3.5.0",
    "uuid": "^14.0.0",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/addon-links": "^10.4.4",
    "@storybook/vue3-vite": "^10.4.4",
    "@types/bootstrap": "^5.2.10",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@types/pako": "^2.0.4",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.9",
    "@vue/tsconfig": "^0.9.1",
    "@eslint/js": "^10.0.1",
    "@eslint/eslintrc": "^3.3.5",
    "eslint": "^10.2.1",
    "eslint-plugin-storybook": "^10.4.4",
    "eslint-plugin-vue": "^10.9.0",
    "jsdom": "^29.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "storybook": "^10.4.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  }
}
